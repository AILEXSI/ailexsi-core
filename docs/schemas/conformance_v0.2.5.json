{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailexsi.dev/schemas/conformance_v0.2.5.json",
  "title": "AILEXSI Phase 04 Conformance Report",
  "type": "object",
  "required": [
    "status",
    "repository",
    "head",
    "physics",
    "conformance",
    "blockers",
    "vectors"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["GREEN", "BLOCKED"] },
    "repository": { "type": "string" },
    "head": { "type": "string" },
    "physics": {
      "type": "object",
      "required": ["core", "graph"],
      "properties": {
        "core": { "type": "string" },
        "graph": { "type": "string" }
      }
    },
    "conformance": {
      "type": "object",
      "required": ["suite", "range", "total", "passed", "failed"],
      "properties": {
        "suite": { "type": "string" },
        "range": { "type": "string" },
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "blocked": { "type": "integer" },
        "skipped": { "type": "integer" }
      }
    },
    "blockers": { "type": "array" },
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cvId", "status"],
        "properties": {
          "cvId": { "type": "string" },
          "formulaId": {},
          "formulaVersion": {},
          "physicsVersion": {},
          "parameterSetId": {},
          "status": { "type": "string" },
          "actual": {},
          "expected": {},
          "tolerance": {},
          "failureClass": {}
        }
      }
    },
    "determinism": { "type": "string" },
    "traceability": { "type": "string" },
    "reportSchema": { "type": "string" },
    "normativeSurface": { "type": "string" },
    "gate": { "type": "object" }
  },
  "additionalProperties": true
}
